# lingzhu 环境配置示例
# 复制此文件为 .env 并修改相应配置

# 应用配置
APP_NAME=lingzhu AI 数字生命系统
APP_VERSION=5.1.0
DEBUG=false

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 环境
ENVIRONMENT=development

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./lingzhu.db

# 认证配置
API_KEY_PREFIX=lz-
TOKEN_EXPIRY_HOURS=24

# 日志配置
LOG_LEVEL=INFO

# 速率限制
RATE_LIMIT_PER_MINUTE=60

# 宇宙引擎配置
MAX_UNIVERSES_PER_CREATOR=10
INITIAL_CREATION_SPARKS=10

# 意识网络配置
MAX_THOUGHT_PROPAGATION_DEPTH=5
MAX_SHORT_TERM_MEMORIES=100
